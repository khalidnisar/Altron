{
  "name": "Altron",
  "description": "Secure Communication App - Hybrid Orchestrator with STAR-style features",
  "version": "2.1.0",
  "workspaces": {
    "default_layout": "vertical",
    "auto_detect_ports": true,
    "show_git_branch": true,
    "show_notifications": true
  },
  "custom_commands": {
    "test-all": "npm test && ./gradlew test",
    "lint": "ktlint && eslint .",
    "orchestrate": "claude --mcp-config .mcp.json",
    "notify-test": "node skills/claude-orchestrator/assets/orchestrator-mcp/star-notify.js --message 'Test notification'"
  },
  "notifications": {
    "osc_support": true,
    "ring_on_waiting": true,
    "max_unread": 20
  },
  "browser": {
    "default_width": 1280,
    "default_height": 800,
    "headless": false,
    "devtools": false
  },
  "agents": {
    "supported": ["opencode", "codex", "autoclaw", "zcode", "cursor", "hermes", "claude"],
    "commands": {
      "_comment": "Add/override worker CLIs without code changes. {PROMPT} = task prompt; ${VAR} in env values resolves from the parent environment at dispatch (no secrets on disk).",
      "opencode": {
        "cmd": "opencode",
        "args": ["run", "-m", "{MODEL}", "{PROMPT}"],
        "models": [
          "opencode/nemotron-3-ultra-free",
          "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
          "openrouter/nvidia/nemotron-3-nano-30b-a3b:free"
        ]
      },
      "autoclaw": {
        "cmd": "autoclaw",
        "args": ["-n", "-y", "-m", "{MODEL}", "chat", "{PROMPT}"],
        "env": {
          "OPENAI_BASE_URL": "https://integrate.api.nvidia.com/v1",
          "OPENAI_API_KEY": "${NVIDIA_API_KEY}"
        },
        "models": [
          "nvidia/nemotron-3-super-120b-a12b",
          "nvidia/nemotron-3-nano-30b-a3b",
          {
            "model": "nvidia/nemotron-3-super-120b-a12b:free",
            "env": {
              "OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
              "OPENAI_API_KEY": "${OPENROUTER_API_KEY}"
            }
          }
        ]
      },
      "_example_zcode_override": { "cmd": "zcode", "args": ["--headless", "{PROMPT}"] }
    },
    "notification_patterns": [
      "waiting for input",
      "needs your attention",
      "done",
      "error",
      "stuck"
    ]
  },
  "hooks": {
    "post_dispatch": "scripts/star/hooks/post-dispatch.sh",
    "on_agent_waiting": "scripts/star/hooks/on-agent-waiting.sh",
    "on_escalate": "scripts/star/hooks/on-escalate.sh"
  }
}
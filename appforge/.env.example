# AppForge AI configuration
#
# Copy to .env  (the Windows start script does this automatically).
# Everything below is OPTIONAL. With no keys set, the platform runs in
# "offline mode": deterministic stub providers stand in for every external
# service, so the full pipeline works end to end with zero paid accounts.

# ---------------------------------------------------------------- core
APPFORGE_ENVIRONMENT=development

# Protects mutating endpoints (approve, reject, seed, trigger).
# Leave blank for local use; set a long random value before exposing the API.
APPFORGE_OPERATOR_TOKEN=

# ---------------------------------------------------------------- database
POSTGRES_USER=appforge
POSTGRES_PASSWORD=appforge
POSTGRES_DB=appforge

# ---------------------------------------------------------------- AI providers
# Set either one to enable live generation for names and store listings.
APPFORGE_OPENAI_API_KEY=
APPFORGE_ANTHROPIC_API_KEY=
APPFORGE_LLM_MODEL=gpt-4o

# ---------------------------------------------------------------- market data
# Without these, discovery uses a deterministic synthetic catalog.
APPFORGE_SENSORTOWER_API_KEY=
APPFORGE_DATAAI_API_KEY=

# ---------------------------------------------------------------- testing
# Enables real-device testing and live simulator streaming in the dashboard.
APPFORGE_BROWSERSTACK_USER=
APPFORGE_BROWSERSTACK_KEY=
APPFORGE_GENYMOTION_API_KEY=

# ---------------------------------------------------------------- publishing
# Absolute path INSIDE the container to a Play Console service account JSON.
# Mount it first, e.g. add to the api service:
#   volumes: [ "./secrets/play.json:/run/secrets/play.json:ro" ]
APPFORGE_PLAY_CONSOLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------- monetization
APPFORGE_ADMOB_APP_ID=
APPFORGE_REVENUECAT_API_KEY=
APPFORGE_SENTRY_DSN=

# ---------------------------------------------------------------- tuning
# Apps scoring above this are auto-queued for deep analysis (blueprint 2.4).
APPFORGE_CLONE_SCORE_THRESHOLD=70
APPFORGE_DISCOVERY_TOP_N_PER_NICHE=100
APPFORGE_REVIEW_SCRAPE_TARGET=10000

# Require a human decision before design and before publishing.
# Strongly recommended to leave enabled.
APPFORGE_REQUIRE_HUMAN_APPROVAL=true

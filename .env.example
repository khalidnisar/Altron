ALTRON_DATA_DIR=data
ALTRON_LOG_LEVEL=INFO
ALPACA_API_KEY=
ALPACA_API_SECRET=
POLYGON_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
TRADINGVIEW_WEBHOOK_SECRET=
# Protects dashboard mutations, account linking, mode changes, and stream control.
ALTRON_OPERATOR_TOKEN=

# --- Website monitor (altron monitor ...) -------------------------------- #
# Comma-separated channels; values: log, telegram, email
ALTRON_MONITOR_NOTIFY=log
ALTRON_MONITORS_DIR=examples/monitors
ALTRON_MONITOR_DB=data/monitor.sqlite
# Telegram (BotFather token + your chat_id)
ALTRON_TELEGRAM_BOT_TOKEN=
ALTRON_TELEGRAM_CHAT_ID=
# SMTP email
ALTRON_SMTP_HOST=
ALTRON_SMTP_PORT=587
ALTRON_SMTP_USER=
ALTRON_SMTP_PASSWORD=
ALTRON_SMTP_TLS=1
ALTRON_EMAIL_FROM=
ALTRON_EMAIL_TO=

# Optional Tradovate read-only connectivity (demo is the default)
TRADOVATE_ENV=demo
TRADOVATE_ACCESS_TOKEN=
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ACCOUNT_SPEC=

# Optional local MetaTrader 5 terminal bridge (normally Windows)
MT5_ENABLE_CONNECTOR=false
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Deliberately absent by default. Real execution also requires --live.
# ALTRON_ENABLE_LIVE_TRADING=I_UNDERSTAND_THE_RISKS
